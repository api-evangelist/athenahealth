{
  "opencollection": "1.0.0",
  "info": {
    "name": "athenahealth athenaOne REST AllergyIntolerance CDS Hooks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.platform.athenahealth.com/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "CDS Hooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Discover CDS Services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.platform.athenahealth.com/v1/{practiceid}/cds-services"
          },
          "docs": "Discover CDS Services"
        },
        {
          "info": {
            "name": "Invoke CDS Service",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.platform.athenahealth.com/v1/{practiceid}/cds-services/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invoke CDS Service"
        }
      ]
    }
  ],
  "bundled": true
}