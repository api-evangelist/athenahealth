{
  "opencollection": "1.0.0",
  "info": {
    "name": "athenahealth athenaOne REST AllergyIntolerance Documents API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.platform.athenahealth.com/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Patient Documents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.platform.athenahealth.com/v1/{practiceid}/patients/:patientid/documents",
            "params": [
              {
                "name": "patientid",
                "value": "",
                "type": "path"
              },
              {
                "name": "departmentid",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Patient Documents"
        }
      ]
    }
  ],
  "bundled": true
}