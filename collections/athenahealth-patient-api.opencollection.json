{
  "opencollection": "1.0.0",
  "info": {
    "name": "athenahealth athenaOne REST AllergyIntolerance Patient API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.platform.athenahealth.com/oauth2/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Patient",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Patients",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.platform.athenahealth.com/v1/{practiceid}/Patient",
            "params": [
              {
                "name": "identifier",
                "value": "",
                "type": "query"
              },
              {
                "name": "family",
                "value": "",
                "type": "query"
              },
              {
                "name": "given",
                "value": "",
                "type": "query"
              },
              {
                "name": "birthdate",
                "value": "",
                "type": "query"
              },
              {
                "name": "_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search Patients"
        },
        {
          "info": {
            "name": "Read Patient",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.platform.athenahealth.com/v1/{practiceid}/Patient/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Read Patient"
        }
      ]
    }
  ],
  "bundled": true
}